 ,ORGL_ET_PK NUMBER(5,0) DEFAULT 0 NOT NULL
 ,ORGL_NAME VARCHAR2(50)
 ,ORGL_FULL_NAME VARCHAR2(150)
 ,ORGL_ORG_PK NUMBER(16,0)
 ,ORGL_DESC VARCHAR2(1024)
 ,ORGL_CHANGE_NO NUMBER(16,0) NOT NULL
 ,ORGL_CRL_ID VARCHAR2(64)
 ,ORGL_REQ_ID VARCHAR2(64)
