PROMPT Creating Table 'ESQ_PERSON_LOG'
CREATE TABLE ESQ_PERSON_LOG
 (
  PEL_ACTION VARCHAR2(1) DEFAULT 'I' NOT NULL
 ,PEL_USR_PK NUMBER(16,0) DEFAULT 0 NOT NULL
 ,PEL_KIND NUMBER(5,0) NOT NULL
 ,PEL_FIRST_NAME VARCHAR2(50)
 ,PEL_MIDDLE_NAME VARCHAR2(50)
 ,PEL_LAST_NAME VARCHAR2(50)
 ,PEL_TITLE VARCHAR2(50)
 ,PEL_DOB DATE
 ,PEL_BIRTH_PLACE VARCHAR2(50)
 ,PEL_SEX VARCHAR2(1)
 ,PEL_TAX_ID VARCHAR2(50)
 ,PEL_CITIZENSHIP VARCHAR2(50)
 ,PEL_MAR_STATUS VARCHAR2(1)
 ,PEL_PERSON_ID_TYPE VARCHAR2(50)
 ,PEL_PERSON_ID_NUMBER VARCHAR2(50)
 ,PEL_EMAIL VARCHAR2(50)
 ,PEL_PHONE VARCHAR2(20)
 ,PEL_PHONE2 VARCHAR2(20)
 ,PEL_BI_PK NUMBER(16,0)
 ,PEL_AD_PK NUMBER(16,0)
 ,PEL_AD_PK_BIZ NUMBER(16,0)
 ,PEL_CRL_ID VARCHAR2(64)
 ,PEL_REQ_ID VARCHAR2(64)
 ,PEL_UID VARCHAR2(16)
 ,PEL_ACTION_TS TIMESTAMP DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP)
 )
/

COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_ACTION IS 'Insert, Update, Delete action code'
/
COMMENT ON TABLE ESQ_PERSON_LOG IS 'Personal information change log'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_USR_PK IS 'Reference to user entity (ESQ_USER). Part of PK'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_KIND IS 'Person kind: Primary, Secondary Contact, Joint. Part of PK'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_FIRST_NAME IS 'First(Given) name'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_MIDDLE_NAME IS 'Middle name'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_LAST_NAME IS 'Last(Family) name'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_TITLE IS 'Title or Honorifics'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_DOB IS 'Date of birthday'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_BIRTH_PLACE IS 'Birth place'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_SEX IS 'Sex code: Male, Female, None'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_TAX_ID IS 'Tax ID or SSN'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_CITIZENSHIP IS 'Citizenship country'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_MAR_STATUS IS 'Martial status, Single, Married, Divorced, Separated'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_PERSON_ID_TYPE IS 'Type of person ID document, Passport, Driver License, State ID, Other'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_PERSON_ID_NUMBER IS 'Number of person ID'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_EMAIL IS 'Email address'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_PHONE IS 'Phone number'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_PHONE2 IS 'Alternative phone number'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_BI_PK IS 'Reference to bank info (ESQ_BANK_INFO)'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_AD_PK IS 'Reference to personal address (ESQ_ADDRESS)'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_AD_PK_BIZ IS 'Reference to business address (ESQ_ADDRESS)'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_UID IS 'Update initator user ID'
/
COMMENT ON COLUMN ESQ_PERSON_LOG.PEL_ACTION_TS IS 'Action timestamp'
/


PROMPT Creating Table 'ESQ_USER_LOG'
CREATE TABLE ESQ_USER_LOG
 (
  USRL_ACTION VARCHAR2(1) DEFAULT 'I' NOT NULL
 ,USRL_PK NUMBER(16,0) DEFAULT 0 NOT NULL
 ,USRL_ET_PK NUMBER(5,0) DEFAULT 0 NOT NULL
 ,USRL_NAME VARCHAR2(50)
 ,USRL_PATH VARCHAR2(512)
 ,USRL_REG_OPTION VARCHAR2(25)
 ,USRL_ORG_PK NUMBER(16,0)
 ,USRL_DELETED_FLG VARCHAR2(1) DEFAULT 'N'
 ,USRL_DESC VARCHAR2(1024)
 ,USRL_CRL_ID VARCHAR2(64)
 ,USRL_REQ_ID VARCHAR2(64)
 ,USRL_UID VARCHAR2(16)
 ,USRL_ACTION_TS TIMESTAMP DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP)
 )
/

COMMENT ON COLUMN ESQ_USER_LOG.USRL_ACTION IS 'Insert, Update, Delete action code'
/
COMMENT ON TABLE ESQ_USER_LOG IS 'User entity change log'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_PK IS 'User primary key'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_ET_PK IS 'User type (reference to ESQ_ENTITY_TYPE)'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_NAME IS 'User name: First M. Last'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_PATH IS 'Entity path'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_REG_OPTION IS 'Registration option: Single, Joint, Corporation, Etc.'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_ORG_PK IS 'Reference to organization unit (ESQ_ORG)'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_DELETED_FLG IS 'Mark as deleted, Y/N flag'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_DESC IS 'Entity description'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_UID IS 'Update initator user ID'
/
COMMENT ON COLUMN ESQ_USER_LOG.USRL_ACTION_TS IS 'Action timestamp'
/


PROMPT Creating Table 'ESQ_AUTH_LOG'
CREATE TABLE ESQ_AUTH_LOG
 (
  AUL_ACTION VARCHAR2(1) DEFAULT 'I' NOT NULL
 ,AUL_USR_PK NUMBER(16,0) DEFAULT 0 NOT NULL
 ,AUL_LOGIN_ID VARCHAR2(50) NOT NULL
 ,AUL_EMAIL VARCHAR2(50) NOT NULL
 ,AUL_CONNECT_FLG VARCHAR2(1) DEFAULT 'N' NOT NULL
 ,AUL_TFA_METHOD VARCHAR2(1) DEFAULT 'N' NOT NULL
 ,AUL_FORCE_CHANGE_FLG VARCHAR2(1)
 ,AUL_SECURITY_QUESTION VARCHAR2(512)
 ,AUL_SECURITY_ANSWER VARCHAR2(512)
 ,AUL_CRL_ID VARCHAR2(64)
 ,AUL_REQ_ID VARCHAR2(64)
 ,AUL_UID VARCHAR2(16)
 ,AUL_ACTION_TS TIMESTAMP DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP)
 )
/

COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_ACTION IS 'Insert, Update, Delete action code'
/
COMMENT ON TABLE ESQ_AUTH_LOG IS 'User credentials change log'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_USR_PK IS 'User primary key, one-to-one FK'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_LOGIN_ID IS 'User Login ID'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_EMAIL IS 'User authentication email address'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_CONNECT_FLG IS 'Connect allowed Y/N flag'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_TFA_METHOD IS 'Two-factor-authentication method: None/Google'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_FORCE_CHANGE_FLG IS 'Force password change Y/N flag'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_SECURITY_QUESTION IS 'Security question'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_SECURITY_ANSWER IS 'Security answer'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_UID IS 'Update initator user ID'
/
COMMENT ON COLUMN ESQ_AUTH_LOG.AUL_ACTION_TS IS 'Action timestamp'
/


