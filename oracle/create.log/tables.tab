/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_PK IS 'Organization primary key'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_ET_PK IS 'Organization type, reference to ESQ_ENTITY_TYPE'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_NAME IS 'Entity name, organization short name'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_FULL_NAME IS 'Organization full name'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_ORG_PK IS 'Reference to parent org unit, ESQ_ORG'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_DESC IS 'Description'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_CHANGE_NO IS 'Change number of the logged row'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_ORG_LOG.ORGL_UID IS 'Update initator user ID'
/
