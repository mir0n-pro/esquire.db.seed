 ,BIL_ADDR VARCHAR2(50)
 ,BIL_CITY VARCHAR2(50)
 ,BIL_PROVINCE VARCHAR2(50)
 ,BIL_POSTAL_CODE VARCHAR2(16)
 ,BIL_COUNTRY VARCHAR2(50)
 ,BIL_SPEC_INSTR VARCHAR2(255)
 ,BIL_BEN_NAME VARCHAR2(250)
 ,BIL_BEN_BANK_NAME VARCHAR2(250)
 ,BIL_BEN_BRANCH_NAME VARCHAR2(250)
 ,BIL_BANK_NAME_I VARCHAR2(250)
 ,BIL_ABA_I VARCHAR2(50)
 ,BIL_SWIFT_I VARCHAR2(50)
 ,BIL_CITY_I VARCHAR2(50)
 ,BIL_COUNTRY_I VARCHAR2(50)
 ,BIL_BEN_NAME_I VARCHAR2(250)
 ,BIL_BEN_BANK_NAME_I VARCHAR2(250)
 ,BIL_BEN_BRANCH_NAME_I VARCHAR2(250)
