PROMPT Creating Table 'ESQ_ACCOUNT_LOG'
CREATE TABLE ESQ_ACCOUNT_LOG
 (
  ACCL_ACTION VARCHAR2(1) DEFAULT 'I' NOT NULL
 ,ACCL_PK NUMBER(16,0) DEFAULT 0 NOT NULL
 ,ACCL_ET_PK NUMBER(5,0) DEFAULT 0 NOT NULL
 ,ACCL_PATH VARCHAR2(512)
 ,ACCL_ID VARCHAR2(50)
 ,ACCL_BALANCE NUMBER(16,3) DEFAULT 0
 ,ACCL_CCY VARCHAR2(3) DEFAULT 'USD'
 ,ACCL_STATUS VARCHAR2(1) DEFAULT 'O'
 ,ACCL_USR_PK NUMBER(16,0) DEFAULT 0
 ,ACCL_DESC VARCHAR2(1024)
 ,ACCL_FUNDED_DT DATE
 ,ACCL_NEG_ALLOWED_FLG VARCHAR2(1) DEFAULT 'N'
 ,ACCL_CRL_ID VARCHAR2(64)
 ,ACCL_REQ_ID VARCHAR2(64)
 ,ACCL_UID VARCHAR2(16)
 ,ACCL_ACTION_TS TIMESTAMP DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP)
 )
/

COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_ACTION IS 'Insert, Update, Delete action code'
/
COMMENT ON TABLE ESQ_ACCOUNT_LOG IS 'User money account change log'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_PK IS 'Account primary key'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_ET_PK IS 'Account type, reference to ESQ_ENTITY_TYPE'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_PATH IS 'Entity path'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_ID IS 'Account ID'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_BALANCE IS 'Account balance'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_CCY IS 'Account denomination, 3 characters currency code'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_STATUS IS 'Account status: Open, Closed, Locked'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_USR_PK IS 'Reference to owner (ESQ_USER table). Foreign key'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_DESC IS 'Entity description'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_FUNDED_DT IS 'Date when the account was funded'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_NEG_ALLOWED_FLG IS 'Negative balance allowed flag, Y/N'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_UID IS 'Update initator user ID'
/
COMMENT ON COLUMN ESQ_ACCOUNT_LOG.ACCL_ACTION_TS IS 'Action timestamp'
/


