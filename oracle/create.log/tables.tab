PROMPT Creating Table 'ESQ_ADDRESS_LOG'
CREATE TABLE ESQ_ADDRESS_LOG
 (
  ADL_ACTION VARCHAR2(1) DEFAULT 'I' NOT NULL
 ,ADL_PK NUMBER(16,0) DEFAULT 0 NOT NULL
 ,ADL_ADDR VARCHAR2(50)
 ,ADL_ADDR2 VARCHAR2(50)
 ,ADL_CITY VARCHAR2(50)
 ,ADL_COMPANY VARCHAR2(50)
 ,ADL_COUNTRY VARCHAR2(50)
 ,ADL_DEPARTMENT VARCHAR2(50)
 ,ADL_DESC VARCHAR2(200)
 ,ADL_FAX VARCHAR2(20)
 ,ADL_POSTAL_CODE VARCHAR2(20)
 ,ADL_PROVINCE VARCHAR2(50)
 ,ADL_TITLE VARCHAR2(50)
 ,ADL_URL VARCHAR2(50)
 ,ADL_CRL_ID VARCHAR2(64)
 ,ADL_REQ_ID VARCHAR2(64)
 ,ADL_UID VARCHAR2(16)
 ,ADL_ACTION_TS TIMESTAMP DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP)
 )
/

COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_ACTION IS 'Insert, Update, Delete action code'
/
COMMENT ON TABLE ESQ_ADDRESS_LOG IS 'Address change log'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_PK IS 'Address primary key'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_ADDR IS 'Street address line 1'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_ADDR2 IS 'Street address line 2'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_CITY IS 'City name'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_COMPANY IS 'Company name (for biz address)'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_COUNTRY IS 'Country name'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_DEPARTMENT IS 'Department name (for biz address)'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_DESC IS 'Address description or additional info'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_FAX IS 'Fax number'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_POSTAL_CODE IS 'Zip or postal code'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_PROVINCE IS 'State or province name'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_TITLE IS 'Title with company (for biz address)'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_URL IS 'Internet URL'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_UID IS 'Update initator user ID'
/
COMMENT ON COLUMN ESQ_ADDRESS_LOG.ADL_ACTION_TS IS 'Action timestamp'
/


PROMPT Creating Table 'ESQ_BANK_INFO_LOG'
CREATE TABLE ESQ_BANK_INFO_LOG
 (
