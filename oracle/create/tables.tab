COMMENT ON COLUMN ESQ_ORG_PAR.OPR_PAR_ET_PK IS 'Entity type, Reference to parameter definition (ESQ_PARAMETER table). Foreign key'
/
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_VALUE IS 'Parameter value'
/
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_UID IS 'Update initator user ID'
/


PROMPT Creating Table 'ESQ_ORG_PAR_LOG'
CREATE TABLE ESQ_ORG_PAR_LOG
 (
  OPRL_ACTION VARCHAR2(1) DEFAULT 'I' NOT NULL
 ,OPRL_ORG_PK NUMBER(16,0) NOT NULL
 ,OPRL_PAR_NAME VARCHAR2(25) NOT NULL
 ,OPRL_PAR_ET_PK NUMBER(5,0) NOT NULL
 ,OPRL_VALUE VARCHAR2(4000)
 ,OPRL_CRL_ID VARCHAR2(64)
 ,OPRL_REQ_ID VARCHAR2(64)
 ,OPRL_UID VARCHAR2(16)
 ,OPRL_ACTION_TS TIMESTAMP DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP)
 )
/

COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_ACTION IS 'Insert, Update, Delete action code'
/
COMMENT ON TABLE ESQ_ORG_PAR_LOG IS 'Organization parameters change log'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_ORG_PK IS 'Reference to organization (ESQ_ORG table). Foreign key'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_PAR_NAME IS 'Parameter name, Reference to parameter definition (ESQ_PARAMETER table). Foreign key'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_PAR_ET_PK IS 'Entity type, Reference to parameter definition (ESQ_PARAMETER table). Foreign key'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_VALUE IS 'Parameter value'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_REQ_ID IS 'Request ID'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_UID IS 'Update initator user ID'
/
COMMENT ON COLUMN ESQ_ORG_PAR_LOG.OPRL_ACTION_TS IS 'Action timestamp'
/


PROMPT Creating Table 'ESQ_ROLE'
CREATE TABLE ESQ_ROLE
 (ROLE_PK NUMBER(5,0) NOT NULL
 ,ROLE_PT_PK INT NOT NULL
 ,ROLE_NAME VARCHAR2(32) NOT NULL
 ,ROLE_DESC VARCHAR2(100)
 )
/
COMMENT ON TABLE ESQ_ROLE IS 'User roles'
/
COMMENT ON COLUMN ESQ_ROLE.ROLE_PK IS 'Role primary key'
/
COMMENT ON COLUMN ESQ_ROLE.ROLE_NAME IS 'Unique role name in upper case'
/
COMMENT ON COLUMN ESQ_ROLE.ROLE_PT_PK IS '980: Admin, 982: Tools: 984: Apps, Reference to ESQ_PERMISSION_TYPE'
/
COMMENT ON COLUMN ESQ_ROLE.ROLE_DESC IS 'Role description'
/


PROMPT Creating Table 'ESQ_ROLE_PRM'
CREATE TABLE ESQ_ROLE_PRM
 (RP_ROLE_PK NUMBER(5,0) NOT NULL
 ,RP_PRM_PK NUMBER(5,0) NOT NULL
 ,RP_ALLOWED_FLGS VARCHAR2(32) NOT NULL
 )
/

COMMENT ON TABLE ESQ_ROLE_PRM IS 'Many-to-many reference ESQ_ROLE - ESQ_PERMISSION'
/
COMMENT ON COLUMN ESQ_ROLE_PRM.RP_ROLE_PK IS 'Refrence to ESQ_ROLE. Foreign key'
/
COMMENT ON COLUMN ESQ_ROLE_PRM.RP_PRM_PK IS 'Refrence to ESQ_PERMISSION. Foreign key'
/
COMMENT ON COLUMN ESQ_ROLE_PRM.RP_ALLOWED_FLGS IS 'Comma separated list of Y/N flags'
/

PROMPT Creating Table 'ESQ_ROLE_ET'
CREATE TABLE ESQ_ROLE_ET
 (RT_ROLE_PK NUMBER(5,0) NOT NULL
 ,RT_ET_PK NUMBER(5,0) NOT NULL
 )
