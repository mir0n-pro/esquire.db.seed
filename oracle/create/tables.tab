PROMPT Creating Table 'ESQ_USER'
CREATE TABLE ESQ_USER
 (USR_PK NUMBER(16,0) DEFAULT 0 NOT NULL
 ,USR_ET_PK NUMBER(5,0) DEFAULT 0 NOT NULL
 ,USR_NAME VARCHAR2(50) NOT NULL
 ,USR_PATH VARCHAR2(512)
 ,USR_REG_OPTION VARCHAR2(25)
 ,USR_ORG_PK NUMBER(16,0) NOT NULL
 ,USR_DELETED_FLG VARCHAR2(1) DEFAULT 'N' NOT NULL 
 ,USR_DESC VARCHAR2(1024)
 ,USR_CREATED_TS TIMESTAMP DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP)
 ,USR_CRL_ID VARCHAR2(64)
 ,USR_REQ_ID VARCHAR2(64)
 ,USR_UID VARCHAR2(16)
 )
/

COMMENT ON TABLE ESQ_USER IS 'User entity'
/
COMMENT ON COLUMN ESQ_USER.USR_PK IS 'User primary key'
/
COMMENT ON COLUMN ESQ_USER.USR_ET_PK IS 'User type (reference to ESQ_ENTITY_TYPE)'
/
COMMENT ON COLUMN ESQ_USER.USR_NAME IS 'User name: First M. Last'
/
COMMENT ON COLUMN ESQ_USER.USR_PATH IS 'Entity path'
/
COMMENT ON COLUMN ESQ_USER.USR_REG_OPTION IS 'Registration option: Single, Joint, Corporation, Etc.'
/
COMMENT ON COLUMN ESQ_USER.USR_ORG_PK IS 'Reference to organization unit (ESQ_ORG)'
/
COMMENT ON COLUMN ESQ_USER.USR_DELETED_FLG IS 'Mark as deleted, Y/N flag'
/
COMMENT ON COLUMN ESQ_USER.USR_DESC IS 'Entity description'
/
COMMENT ON COLUMN ESQ_USER.USR_CREATED_TS IS 'Entity created timestamp'
/
COMMENT ON COLUMN ESQ_USER.USR_CRL_ID IS 'Correlation ID'
/
COMMENT ON COLUMN ESQ_USER.USR_REQ_ID IS 'Request ID'
/
