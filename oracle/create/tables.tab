--
-- 01/14/2026 mir0n ESQ_USR_PRM table removed
--                  ESQ_USER.USR_EMAIL unique index added
--                  ESQ_PERMISSION.PRM_ET_USR_FK field removed
--                  ESQ_ROLE table added with many-to-many references
--                  ESQ_AUTH table simplified
--                  ESQ_PARAMETER.PAR_PERSONAL_FLG added
-- 02/19/2026 mir0n audit columns added to ESQ_ADDRESS, ESQ_BANK_INFO, ESQ_PERSON,
--                    ESQ_USER, ESQ_AUTH, ESQ_ORG, ESQ_ACCOUNT, ESQ_USR_PAR, ESQ_ORG_PAR:
--                    *_CRL_ID (Correlation ID), *_REQ_ID (Request ID), *_UID (Update user ID)
--                  ESQ_ADDRESS: AD_EMAIL, AD_PHONE, AD_PHONE2 moved to ESQ_PERSON
--                  ESQ_PERSON: PE_EMAIL, PE_PHONE, PE_PHONE2 added
-- 02/24/2026 mir0n ESQ_USER: USR_REG_OPTION made nullable
--                  Audit log tables added: ESQ_USER_LOG, ESQ_ADDRESS_LOG,
--                    ESQ_BANK_INFO_LOG, ESQ_PERSON_LOG, ESQ_AUTH_LOG,
--                    ESQ_ORG_LOG, ESQ_ACCOUNT_LOG, ESQ_USR_PAR_LOG, ESQ_ORG_PAR_LOG
-- 02/28/2026 mir0n ESQ_PERSON.PE_KIND: VARCHAR2(1) DEFAULT 'P' -> NUMBER(5,0) DEFAULT 992
--                  ESQ_PERSON_LOG.PEL_KIND: VARCHAR2(1) -> NUMBER(5,0)
-- 03/03/2026 mir0n ESQ_ROLE: ROLE_ADMIN_FLG VARCHAR2(1) replaced by ROLE_PT_PK INT
--                  (FK reference to ESQ_PERMISSION_TYPE; 980: Admin, 982: Tools)
-- 03/28/2026 mir0n ESQ_PARAMETER.PAR_DEFAULT VARCHAR2(4000) added
--
