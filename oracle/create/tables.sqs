-- History:
-- 04/20/2026 mir0n ESQ_ATR_SEQ removed (transaction PK is now a string ID)

PROMPT Creating Sequence 'ESQ_ENTITY_SEQ'
CREATE SEQUENCE ESQ_ENTITY_SEQ
 INCREMENT BY 1 
 START WITH 100 
 MINVALUE 100
 MAXVALUE 9999999999999999
 NOCACHE
/

PROMPT Creating Sequence 'ESQ_REF_SEQ'
CREATE SEQUENCE ESQ_REF_SEQ
 INCREMENT BY 1 
 START WITH 1
 MINVALUE 1
 MAXVALUE 9999999999999999
 NOCYCLE
 NOCACHE
/
