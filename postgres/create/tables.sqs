-- History:
-- 04/20/2026 mir0n ESQ_ATR_SEQ removed (transaction PK is now a string ID)
-- 08/11/2026 mir0n v1.2.12 ESQ_ENTITY_SEQ removed -- entity keys are minted by the application; ESQ_REF_SEQ stays

\echo -n Creating Sequence 'ESQ_REF_SEQ\n'
CREATE SEQUENCE ESQ_REF_SEQ
 INCREMENT BY 1 
 START WITH 1
 MINVALUE 1
 MAXVALUE 9999999999999999
 NO CYCLE
 CACHE 1;
