--\set QUIET 1

\echo -n Creating Table 'ESQ_ADDRESS\n'
CREATE TABLE ESQ_ADDRESS
 (AD_PK BIGINT DEFAULT 0 NOT NULL
 ,AD_ADDR VARCHAR(50)
 ,AD_ADDR2 VARCHAR(50)
 ,AD_CITY VARCHAR(50)
 ,AD_COMPANY VARCHAR(50)
 ,AD_COUNTRY VARCHAR(50)
 ,AD_DEPARTMENT VARCHAR(50)
 ,AD_DESC VARCHAR(200)
 ,AD_EMAIL VARCHAR(50)
 ,AD_FAX VARCHAR(20)
 ,AD_PHONE VARCHAR(20)
 ,AD_PHONE2 VARCHAR(20)
 ,AD_POSTAL_CODE VARCHAR(20)
 ,AD_PROVINCE VARCHAR(50)
 ,AD_TITLE VARCHAR(50)
 ,AD_URL VARCHAR(50)
 );

COMMENT ON TABLE ESQ_ADDRESS IS 'Address information';
COMMENT ON COLUMN ESQ_ADDRESS.AD_PK IS 'Address primary key';
COMMENT ON COLUMN ESQ_ADDRESS.AD_ADDR IS 'Street address line 1';
COMMENT ON COLUMN ESQ_ADDRESS.AD_ADDR2 IS 'Street address line 2';
COMMENT ON COLUMN ESQ_ADDRESS.AD_CITY IS 'Sity name';
COMMENT ON COLUMN ESQ_ADDRESS.AD_COMPANY IS 'Company name (for biz address)';
COMMENT ON COLUMN ESQ_ADDRESS.AD_COUNTRY IS 'Country name';
COMMENT ON COLUMN ESQ_ADDRESS.AD_DEPARTMENT IS 'Department name (for biz address)';
COMMENT ON COLUMN ESQ_ADDRESS.AD_DESC IS 'Address description or additional info';
COMMENT ON COLUMN ESQ_ADDRESS.AD_EMAIL IS 'Email address';
COMMENT ON COLUMN ESQ_ADDRESS.AD_FAX IS 'Fax number';
COMMENT ON COLUMN ESQ_ADDRESS.AD_PHONE IS 'Phone number';
COMMENT ON COLUMN ESQ_ADDRESS.AD_PHONE2 IS 'Alternative phone number';
COMMENT ON COLUMN ESQ_ADDRESS.AD_POSTAL_CODE IS 'Zip or postal code';
COMMENT ON COLUMN ESQ_ADDRESS.AD_PROVINCE IS 'State or province name';
COMMENT ON COLUMN ESQ_ADDRESS.AD_TITLE IS 'Title with company (for biz address)';
COMMENT ON COLUMN ESQ_ADDRESS.AD_URL IS 'Internet URL';


\echo -n Creating Table 'ESQ_BANK_INFO\n'
CREATE TABLE ESQ_BANK_INFO
 (BI_PK BIGINT DEFAULT 0 NOT NULL
 ,BI_NAME VARCHAR(50)
 ,BI_BANK_NAME VARCHAR(250)
 ,BI_BANK_CCY VARCHAR(10)
 ,BI_ABA VARCHAR(50)
 ,BI_SWIFT VARCHAR(50)
 ,BI_ACCT VARCHAR(50)
 ,BI_ADDR VARCHAR(50)
 ,BI_CITY VARCHAR(50)
 ,BI_PROVINCE VARCHAR(50)
 ,BI_POSTAL_CODE VARCHAR(16)
 ,BI_COUNTRY VARCHAR(50)
 ,BI_SPEC_INSTR VARCHAR(255)
 ,BI_BEN_NAME VARCHAR(250)
 ,BI_BEN_BANK_NAME VARCHAR(250)
 ,BI_BEN_BRANCH_NAME VARCHAR(250)
 ,BI_BANK_NAME_I VARCHAR(250)
 ,BI_ABA_I VARCHAR(50)
 ,BI_SWIFT_I VARCHAR(50)
 ,BI_CITY_I VARCHAR(50)
 ,BI_COUNTRY_I VARCHAR(50)
 ,BI_BEN_NAME_I VARCHAR(250)
 ,BI_BEN_BANK_NAME_I VARCHAR(250)
 ,BI_BEN_BRANCH_NAME_I VARCHAR(250)
 );

COMMENT ON TABLE ESQ_BANK_INFO IS 'Bank information';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_PK IS 'Bank info primary key';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_NAME IS 'Bank info name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BANK_CCY IS 'Bank account currency';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_ABA IS 'American bank Association code';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_ACCT IS 'Account number';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BANK_NAME IS 'Bank name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_SWIFT IS 'Society for Worldwide Interbank code';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_SWIFT IS 'Bank address line';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_CITY IS 'Bank address city';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_PROVINCE IS 'Bank address province';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_POSTAL_CODE IS 'Bank address postal code (zip)';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_COUNTRY IS 'Bank address country';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_SPEC_INSTR IS 'Bank special instructions';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BEN_NAME IS 'Beneficiary name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BEN_BANK_NAME IS 'Beneficiary bank name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BEN_BRANCH_NAME IS 'Beneficiary bank branch name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BANK_NAME_I IS 'Intermediary Bank name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_ABA_I IS 'Intermediary bank ABA code';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_SWIFT_I IS 'Intermediary bank SWIFT code';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_CITY_I IS 'Intermediary bank address city';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_COUNTRY_I IS 'Intermediary bank address country';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BEN_NAME_I IS 'Intermediary beneficiary name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BEN_BANK_NAME_I IS 'Intermediary beneficiary bank name';
COMMENT ON COLUMN ESQ_BANK_INFO.BI_BEN_BRANCH_NAME_I IS 'Intermediary beneficiary bank branch name';


\echo -n Creating Table 'ESQ_PERSON\n'
CREATE TABLE ESQ_PERSON
 (PE_USR_PK BIGINT DEFAULT 0 NOT NULL
 ,PE_KIND VARCHAR(1) DEFAULT 'P' NOT NULL
 ,PE_FIRST_NAME VARCHAR(50)
 ,PE_MIDDLE_NAME VARCHAR(50)
 ,PE_LAST_NAME VARCHAR(50)
 ,PE_TITLE VARCHAR(50)
 ,PE_DOB DATE
 ,PE_BIRTH_PLACE VARCHAR(50)
 ,PE_SEX VARCHAR(1)
 ,PE_TAX_ID VARCHAR(50)
 ,PE_CITIZENSHIP VARCHAR(50)
 ,PE_MAR_STATUS VARCHAR(1)
 ,PE_PERSON_ID_TYPE VARCHAR(50)
 ,PE_PERSON_ID_NUMBER VARCHAR(50)
 ,PE_BI_PK BIGINT 
 ,PE_AD_PK BIGINT 
 ,PE_AD_PK_BIZ BIGINT 
 );

COMMENT ON TABLE ESQ_PERSON IS 'Personal information\n';

COMMENT ON COLUMN ESQ_PERSON.PE_USR_PK IS 'Reference to user entity (ESQ_USR). Part of PK';
COMMENT ON COLUMN ESQ_PERSON.PE_KIND IS 'Person kind : Primary, Secondary Contact, Joint. Part of PK';
COMMENT ON COLUMN ESQ_PERSON.PE_FIRST_NAME IS 'First(Given) name';
COMMENT ON COLUMN ESQ_PERSON.PE_MIDDLE_NAME IS 'Middle name';
COMMENT ON COLUMN ESQ_PERSON.PE_LAST_NAME IS 'Last(Family) name';
COMMENT ON COLUMN ESQ_PERSON.PE_TITLE IS 'Title or Honorifics';
COMMENT ON COLUMN ESQ_PERSON.PE_DOB IS 'Date of birthday';
COMMENT ON COLUMN ESQ_PERSON.PE_BIRTH_PLACE IS 'Birth place';
COMMENT ON COLUMN ESQ_PERSON.PE_SEX IS 'Sex code: Male, Female, None';
COMMENT ON COLUMN ESQ_PERSON.PE_TAX_ID IS 'Tax ID or SSN';
COMMENT ON COLUMN ESQ_PERSON.PE_CITIZENSHIP IS 'Citizenship country';
COMMENT ON COLUMN ESQ_PERSON.PE_MAR_STATUS IS 'Martial status, Single, Married, Divorced, Separated';
COMMENT ON COLUMN ESQ_PERSON.PE_PERSON_ID_TYPE IS 'Type of person ID document, Passport, Driver License, State ID, Other';
COMMENT ON COLUMN ESQ_PERSON.PE_PERSON_ID_NUMBER IS 'Number of person ID';
COMMENT ON COLUMN ESQ_PERSON.PE_BI_PK IS 'Reference to bank info (ESQ_BANK_INFO)';
COMMENT ON COLUMN ESQ_PERSON.PE_AD_PK IS 'Reference to personal address (ESQ_ADDRESS)';
COMMENT ON COLUMN ESQ_PERSON.PE_AD_PK_BIZ IS 'Reference to business address (ESQ_ADDRESS)';

\echo -n Creating Table 'ESQ_USER\n'
CREATE TABLE ESQ_USER
 (USR_PK BIGINT DEFAULT 0 NOT NULL
 ,USR_ET_PK INT DEFAULT 0 NOT NULL
 ,USR_NAME VARCHAR(50) NOT NULL
 ,USR_PATH VARCHAR(512)
 ,USR_LOGIN_ID VARCHAR(50) NOT NULL
 ,USR_EMAIL VARCHAR(50) NOT NULL
 ,USR_REG_OPTION VARCHAR(25) NOT NULL
 ,USR_ORG_PK BIGINT NOT NULL
 ,USR_DELETED_FLG VARCHAR(1) DEFAULT 'N' NOT NULL 
 ,USR_DESC VARCHAR(1024)
 );

COMMENT ON TABLE ESQ_USER IS 'User entity';
COMMENT ON COLUMN ESQ_USER.USR_PK IS 'User primary key';
COMMENT ON COLUMN ESQ_USER.USR_ET_PK IS 'User type (reference to ESQ_ENTITY_TYPE)';
COMMENT ON COLUMN ESQ_USER.USR_NAME IS 'User name: First M. Last';
COMMENT ON COLUMN ESQ_USER.USR_PATH IS 'Entity path';
COMMENT ON COLUMN ESQ_USER.USR_LOGIN_ID IS 'User Login ID';
COMMENT ON COLUMN ESQ_USER.USR_EMAIL IS 'User authentication email address';
COMMENT ON COLUMN ESQ_USER.USR_REG_OPTION IS 'Registration option: Single, Joint, Corporation, Etc.';
COMMENT ON COLUMN ESQ_USER.USR_ORG_PK IS 'Reference to organization unit (ESQ_ORG)';
COMMENT ON COLUMN ESQ_USER.USR_DELETED_FLG IS 'Mark as deleted, Y/N flag';
COMMENT ON COLUMN ESQ_USER.USR_DESC IS 'Entity description';

\echo -n Creating Table 'ESQ_AUTH\n'
CREATE TABLE ESQ_AUTH
 (AU_USR_PK BIGINT DEFAULT 0 NOT NULL
 ,AU_CONNECT_FLG VARCHAR(1) DEFAULT 'N' NOT NULL
 ,AU_TFA_METHOD VARCHAR(1) DEFAULT 'N' NOT NULL
 ,AU_FORCE_CHANGE_FLG VARCHAR(1)
 ,AU_SECURITY_QUESTION VARCHAR(512)
 ,AU_SECURITY_ANSWER VARCHAR(512)
 );

COMMENT ON TABLE ESQ_AUTH IS 'User credentials\n';
COMMENT ON COLUMN ESQ_AUTH.AU_USR_PK IS 'User primary key, one-to-one FK';
COMMENT ON COLUMN ESQ_AUTH.AU_CONNECT_FLG IS 'Connect allowed Y/N flag';
COMMENT ON COLUMN ESQ_AUTH.AU_TFA_METHOD IS 'Two-factor-authentication method: None/Goggle';
COMMENT ON COLUMN ESQ_AUTH.AU_FORCE_CHANGE_FLG IS 'Force password change Y/N flag';
COMMENT ON COLUMN ESQ_AUTH.AU_SECURITY_QUESTION IS 'Security question';
COMMENT ON COLUMN ESQ_AUTH.AU_SECURITY_ANSWER IS 'Security answer';

\echo -n Creating Table 'ESQ_ORG\n'
CREATE TABLE ESQ_ORG
 (ORG_PK BIGINT DEFAULT 0 NOT NULL
 ,ORG_ET_PK INT DEFAULT 0 NOT NULL
 ,ORG_NAME VARCHAR(50) NOT NULL
 ,ORG_PATH VARCHAR(512)
 ,ORG_FULL_NAME VARCHAR(150)
 ,ORG_ORG_PK BIGINT
 ,ORG_DESC VARCHAR(1024)
 );

COMMENT ON TABLE ESQ_ORG IS 'Organization unit entity';
COMMENT ON COLUMN ESQ_ORG.ORG_PK IS 'Organization primary key';
COMMENT ON COLUMN ESQ_ORG.ORG_ET_PK IS 'Organization type, reference to ESQ_ENTITY_TYPE';
COMMENT ON COLUMN ESQ_ORG.ORG_NAME IS 'Entity name, organization short name';
COMMENT ON COLUMN ESQ_ORG.ORG_PATH IS 'Entity path';
COMMENT ON COLUMN ESQ_ORG.ORG_FULL_NAME IS 'Organization full name';
COMMENT ON COLUMN ESQ_ORG.ORG_ORG_PK IS 'Reference to parent org unit, ESQ_ORG';
COMMENT ON COLUMN ESQ_ORG.ORG_DESC IS 'Description';



\echo -n Creating Table 'ESQ_ACCOUNT\n'
CREATE TABLE ESQ_ACCOUNT
 (ACC_PK BIGINT DEFAULT 0 NOT NULL
 ,ACC_ET_PK INT DEFAULT 0 NOT NULL
 ,ACC_PATH VARCHAR(512)
 ,ACC_ID VARCHAR(50)
 ,ACC_BALANCE NUMERIC(3) DEFAULT 0 NOT NULL
 ,ACC_CCY VARCHAR(3) DEFAULT 'USD' NOT NULL
 ,ACC_STATUS VARCHAR(1) DEFAULT 'O' NOT NULL
 ,ACC_USR_PK BIGINT DEFAULT 0 NOT NULL 
 ,ACC_DESC VARCHAR(1024)
 );

COMMENT ON TABLE ESQ_ACCOUNT IS 'User money account';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_PK IS 'Account primary key';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_ET_PK IS 'Account type, reference to ESQ_ENTITY_TYPE';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_PATH IS 'Entity path';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_ID IS 'Account ID';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_BALANCE IS 'Account balance';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_CCY IS 'Account denomination, 3 characters currency code';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_STATUS IS 'Account status: Open, Closed, Locked';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_USR_PK IS 'Reference to owner (ESQ_USER table). Foreign key';
COMMENT ON COLUMN ESQ_ACCOUNT.ACC_DESC IS 'Entity description';

\echo -n Creating Table 'ESQ_ACTIVITY_TYPE\n'
CREATE TABLE ESQ_ACTIVITY_TYPE
 (AT_PK INT DEFAULT 0 NOT NULL
 ,AT_DESC VARCHAR(500)
 ,AT_NAME VARCHAR(25)
 );

COMMENT ON TABLE ESQ_ACTIVITY_TYPE IS 'Account activity type';
COMMENT ON COLUMN ESQ_ACTIVITY_TYPE.AT_PK IS 'Account activity type unique code.';
COMMENT ON COLUMN ESQ_ACTIVITY_TYPE.AT_DESC IS 'Account activity description';
COMMENT ON COLUMN ESQ_ACTIVITY_TYPE.AT_NAME IS 'Account activity short name';

\echo -n Creating Table 'ESQ_ACCT_TRANSACTION\n'
CREATE TABLE ESQ_ACCT_TRANSACTION
 (ATR_PK BIGINT DEFAULT 0 NOT NULL
 ,ATR_ACC_PK BIGINT NOT NULL
 ,ATR_AT_PK INT NOT NULL
 ,ATR_AMT_INCOMING BIGINT
 ,ATR_CCY_INCOMING VARCHAR(3)
 ,ATR_CONV_RATE NUMERIC(8)
 ,ATR_AMT NUMERIC(3) DEFAULT 0 NOT NULL
 ,ATR_PREV_BALANCE NUMERIC(3) DEFAULT 0 NOT NULL
 ,ATR_DT TIMESTAMP
 ,ATR_DESC VARCHAR(512)
 );

COMMENT ON TABLE ESQ_ACCT_TRANSACTION IS 'Account activity transactions';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_PK IS 'Account activity primary key';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_ACC_PK IS 'Reference to account (ESQ_ACCOUNTS table). Foreign key';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_AT_PK IS 'Reference to activity type (ESQ_ACTIVITY_TYPES table). Foreign key';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_AMT_INCOMING IS 'Transaction incoming amount';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_CCY_INCOMING IS 'Transaction incoming currency';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_CONV_RATE IS 'Conversion rate for incoming amount';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_AMT IS 'Transaction amount posted to account';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_PREV_BALANCE IS 'Account balance before transaction';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_DT IS 'Transaction time';
COMMENT ON COLUMN ESQ_ACCT_TRANSACTION.ATR_DESC IS 'Transaction description';

\echo -n Creating Table 'ESQ_ENTITY_TYPE\n'
CREATE TABLE ESQ_ENTITY_TYPE
 (ET_PK INT DEFAULT 0 NOT NULL
 ,ET_NAME VARCHAR(25) NOT NULL
 ,ET_DESC VARCHAR(100)
 ,ET_ACC_FLG VARCHAR(1) DEFAULT 'N' NOT NULL
 ,ET_USR_FLG VARCHAR(1) DEFAULT 'N' NOT NULL
 ,ET_ORG_FLG VARCHAR(1) DEFAULT 'N' NOT NULL
 ,ET_LINK_FLG VARCHAR(1) DEFAULT 'N' NOT NULL
 ,ET_TREE_FLGS VARCHAR(8) DEFAULT 'Bb' NOT NULL 
 );

COMMENT ON TABLE ESQ_ENTITY_TYPE IS 'Types of  entity';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_PK IS 'Entity type code';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_NAME IS 'Entity type name';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_DESC IS 'Entity type description';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_ACC_FLG IS 'Account kind of entity, Y/N flag';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_USR_FLG IS 'User kind of entity, Y/N flag';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_ORG_FLG IS 'Organization kind of entity, Y/N flag';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_LINK_FLG IS 'Shortcut flag';
COMMENT ON COLUMN ESQ_ENTITY_TYPE.ET_TREE_FLGS IS 'Set of flags for GUI';

\echo -n Creating Table 'ESQ_PERMISSION_TYPE\n'
CREATE TABLE ESQ_PERMISSION_TYPE
 (PT_PK INT DEFAULT 0 NOT NULL
 ,PT_NAME VARCHAR(25) NOT NULL
 ,PT_DESC VARCHAR(100)
 );

COMMENT ON TABLE ESQ_PERMISSION_TYPE IS 'Permission type';
COMMENT ON COLUMN ESQ_PERMISSION_TYPE.PT_PK IS 'Permission type code';
COMMENT ON COLUMN ESQ_PERMISSION_TYPE.PT_NAME IS 'Permission type name';
COMMENT ON COLUMN ESQ_PERMISSION_TYPE.PT_DESC IS 'Permission type description';


\echo -n Creating Table 'ESQ_PERMISSION\n'
CREATE TABLE ESQ_PERMISSION
 (PRM_PK INT DEFAULT 0 NOT NULL
 ,PRM_NAME VARCHAR(50) NOT NULL
 ,PRM_DESC VARCHAR(100)
 ,PRM_ET_PK INT
 ,PRM_PT_PK INT
 );

COMMENT ON TABLE ESQ_PERMISSION IS 'User permission definition';
COMMENT ON COLUMN ESQ_PERMISSION.PRM_PK IS 'Permission code';
COMMENT ON COLUMN ESQ_PERMISSION.PRM_NAME IS 'Permission name';
COMMENT ON COLUMN ESQ_PERMISSION.PRM_DESC IS 'Permission description';
COMMENT ON COLUMN ESQ_PERMISSION.PRM_PT_PK IS 'Permission type, reference to ESQ_PERMISSION_TYPE';
COMMENT ON COLUMN ESQ_PERMISSION.PRM_ET_PK IS 'Entity type where permission applied, reference to ESQ_ENTITY_TYPE';

\echo -n Creating Table 'ESQ_PARAMETER\n'
CREATE TABLE ESQ_PARAMETER
 (PAR_ET_PK INT NOT NULL
 ,PAR_NAME VARCHAR(25) NOT NULL
 ,PAR_DESC VARCHAR(50)
 ,PAR_TYPE VARCHAR(25) DEFAULT 'STRING' NOT NULL
 ,PAR_LABEL VARCHAR(25) NOT NULL
 ,PAR_READWRITE SMALLINT DEFAULT 0 NOT NULL
 ,PAR_LAYER INT DEFAULT 1 NOT NULL
 ,PAR_SORT INT DEFAULT 0 NOT NULL
 ,PAR_TOOLTIP VARCHAR(50)
 ,PAR_NULLMEANING VARCHAR(50)
 ,PAR_NULLABLE_FLG VARCHAR(1) DEFAULT 'Y' NOT NULL
 ,PAR_VALIDATION VARCHAR(512)
 ,PAR_LISTVALUES VARCHAR(4000)
 ,PAR_FORMAT VARCHAR(4000)
 ,PAR_PERSONAL_FLG VARCHAR(1)
 );


COMMENT ON TABLE ESQ_PARAMETER IS 'Entity parameter definition';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_NAME IS 'Parameter name';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_DESC IS 'Parameter description';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_TYPE IS 'Parameter value type';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_LABEL IS 'Parameter UI label';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_READWRITE IS 'Parameter read-write bitmap:0 - Hidden;1 - Read only;3- Editable (read and write)';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_LAYER IS 'Parameter layer: UI tab number';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_SORT IS 'Parameter order number in UI layer';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_TOOLTIP IS 'Parameter tooltip';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_NULLMEANING IS 'Meaning for of NULL value';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_VALIDATION IS 'Validation rule, regex syntax';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_LISTVALUES IS 'List of possible values in dropdown list';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_FORMAT IS 'Format for NUMBER and DATETIME; Alt text for IMAGE; Link text for HREF';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_NULLABLE_FLG IS 'Y/N flag indicates whether value can be NULL';
COMMENT ON COLUMN ESQ_PARAMETER.PAR_PERSONAL_FLG IS 'Y/N flag indicates whether value can be modifiend by profile owner';


\echo -n Creating Table 'ESQ_USR_PAR\n'
CREATE TABLE ESQ_USR_PAR
 (UPR_USR_PK BIGINT NOT NULL
 ,UPR_PAR_NAME VARCHAR(25) NOT NULL
 ,UPR_PAR_ET_PK INT NOT NULL
 ,UPR_VALUE VARCHAR(4000)
 );
COMMENT ON TABLE ESQ_USR_PAR IS 'User parameters';
COMMENT ON COLUMN ESQ_USR_PAR.UPR_USR_PK IS 'Reference to user (ESQ_USR table). Foreign key';
COMMENT ON COLUMN ESQ_USR_PAR.UPR_PAR_NAME IS 'Parameter name, Reference to parameter definition (ESQ_PARAMETER table). Foreign key';
COMMENT ON COLUMN ESQ_USR_PAR.UPR_PAR_ET_PK IS 'Entity type, Reference to parameter definition (ESQ_PARAMETER table). Foreign key';
COMMENT ON COLUMN ESQ_USR_PAR.UPR_VALUE IS 'Parameter value';

\echo -n Creating Table 'ESQ_ORG_PAR\n'
CREATE TABLE ESQ_ORG_PAR
 (OPR_ORG_PK BIGINT NOT NULL
 ,OPR_PAR_NAME VARCHAR(25) NOT NULL
 ,OPR_PAR_ET_PK INT NOT NULL
 ,OPR_VALUE VARCHAR(4000)
 );
COMMENT ON TABLE ESQ_ORG_PAR IS 'Organization parameters';
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_ORG_PK IS 'Reference to organization (ESQ_ORG table). Foreign key';
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_PAR_NAME IS 'Parameter name, Reference to parameter definition (ESQ_PARAMETER table). Foreign key';
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_PAR_ET_PK IS 'Entity type, Reference to parameter definition (ESQ_PARAMETER table). Foreign key';
COMMENT ON COLUMN ESQ_ORG_PAR.OPR_VALUE IS 'Parameter value';


\echo -n Creating Table 'ESQ_ROLE\n'
CREATE TABLE ESQ_ROLE
 (ROLE_PK INT NOT NULL
 ,ROLE_NAME VARCHAR(32) NOT NULL
 ,ROLE_DESC VARCHAR(100)
 );

COMMENT ON TABLE ESQ_ROLE IS 'User roles';
COMMENT ON COLUMN ESQ_ROLE.ROLE_PK IS 'Role primary key';
COMMENT ON COLUMN ESQ_ROLE.ROLE_NAME IS 'Unique role name in upper case';
COMMENT ON COLUMN ESQ_ROLE.ROLE_DESC IS 'Role description';


\echo -n Creating Table 'ESQ_ROLE_PRM\n'
CREATE TABLE ESQ_ROLE_PRM
 (RP_ROLE_PK INT NOT NULL
 ,RP_PRM_PK INT NOT NULL
 ,RP_ALLOWED_FLGS VARCHAR(32) NOT NULL
 );

COMMENT ON TABLE ESQ_ROLE_PRM IS 'Many-to-many reference ESQ_ROLE - ESQ_PERMISSION';
COMMENT ON COLUMN ESQ_ROLE_PRM.RP_ROLE_PK IS 'Refrence to ESQ_ROLE. Foreign key';
COMMENT ON COLUMN ESQ_ROLE_PRM.RP_PRM_PK IS 'Refrence to ESQ_PERMISSION. Foreign key';
COMMENT ON COLUMN ESQ_ROLE_PRM.RP_ALLOWED_FLGS IS 'Comma separated list of Y/N flags';


\echo -n Creating Table 'ESQ_ROLE_ET\n'
CREATE TABLE ESQ_ROLE_ET
 (RT_ROLE_PK INT NOT NULL
 ,RT_ET_PK INT NOT NULL
 );

COMMENT ON TABLE ESQ_ROLE_ET IS 'Many-to-many reference ESQ_ROLE - ESQ_ENTITY_TYPE';
COMMENT ON COLUMN ESQ_ROLE_ET.RT_ROLE_PK IS 'Reference to ESQ_ROLE. Foreign key';
COMMENT ON COLUMN ESQ_ROLE_ET.RT_ET_PK IS 'Reference to ESQ_ENTITY_TYPE. Foreign key';

\echo -n Creating Table 'ESQ_USR_ROLE\n'
CREATE TABLE ESQ_USR_ROLE
 (UR_USR_PK BIGINT NOT NULL
 ,UR_ROLE_PK INT NOT NULL
 );

COMMENT ON TABLE ESQ_USR_ROLE IS 'Many-to-many reference ESQ_ROLE - ESQ_USER';
COMMENT ON COLUMN ESQ_USR_ROLE.UR_ROLE_PK IS 'Reference to ESQ_ROLE. Foreign key';
COMMENT ON COLUMN ESQ_USR_ROLE.UR_USR_PK IS 'Reference to ESQ_USER. Foreign key';

--\set QUIET 0
