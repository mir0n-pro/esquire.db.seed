SELECT 'Creating Sequence ESQ_ENTITY_SEQ' AS status;
CREATE SEQUENCE ESQ_ENTITY_SEQ
 INCREMENT BY 1
 START WITH 100;

SELECT 'Creating Sequence ESQ_REF_SEQ' AS status;
CREATE SEQUENCE ESQ_REF_SEQ
 INCREMENT BY 1
 START WITH 1;

SELECT 'Creating Sequence ESQ_ATR_SEQ' AS status;
CREATE SEQUENCE ESQ_ATR_SEQ
 INCREMENT BY 1
 START WITH 1;
